// ============================================================================
// CREATING NEW BLUEPRINT ASSETS
// ============================================================================

UBlueprint* UBlueprintEditorUtilities::CreateNewBlueprint(const FString& PackagePath, const FString& BlueprintName, UClass* ParentClass)
{
    if (!ParentClass)
    {
        UE_LOG(LogTemp, Error, TEXT("Parent class is null!"));
        return nullptr;
    }

    // Create package for the new Blueprint
    FString PackageName = PackagePath + BlueprintName;
    UPackage* Package = CreatePackage(*PackageName);
    
    if (!Package)
    {
        UE_LOG(LogTemp, Error, TEXT("Failed to create package: %s"), *PackageName);
        return nullptr;
    }

    // Create the Blueprint
    UBlueprint* NewBlueprint = FKismetEditorUtilities::CreateBlueprint(
        ParentClass,
        Package,
        FName(*BlueprintName),
        BPTYPE_Normal,
        UBlueprint::StaticClass(),
        UBlueprintGeneratedClass::StaticClass(),
        NAME_None
    );

    if (NewBlueprint)
    {
        // Mark as modified
        NewBlueprint->MarkPackageDirty();
        
        // Compile
        FKismetEditorUtilities::CompileBlueprint(NewBlueprint);
        
        // Notify asset registry
        FAssetRegistryModule::AssetCreated(NewBlueprint);
        
        UE_LOG(LogTemp, Log, TEXT("Created Blueprint: %s"), *BlueprintName);
    }

    return NewBlueprint;
}

UBlueprint* UBlueprintEditorUtilities::CreateBlueprintInterface(const FString& PackagePath, const FString& InterfaceName)
{
    FString PackageName = PackagePath + InterfaceName;
    UPackage* Package = CreatePackage(*PackageName);
    
    if (!Package)
    {
        return nullptr;
    }

    UBlueprint* NewInterface = FKismetEditorUtilities::CreateBlueprint(
        UInterface::StaticClass(),
        Package,
        FName(*InterfaceName),
        BPTYPE_Interface,
        UBlueprint::StaticClass(),
        UBlueprintGeneratedClass::StaticClass(),
        NAME_None
    );

    if (NewInterface)
    {
        NewInterface->MarkPackageDirty();
        FAssetRegistryModule::AssetCreated(NewInterface);
        
        UE_LOG(LogTemp, Log, TEXT("Created Blueprint Interface: %s"), *InterfaceName);
    }

    return NewInterface;
}

UBlueprint* UBlueprintEditorUtilities::CreateBlueprintFunctionLibrary(const FString& PackagePath, const FString& LibraryName)
{
    FString PackageName = PackagePath + LibraryName;
    UPackage* Package = CreatePackage(*PackageName);
    
    if (!Package)
    {
        return nullptr;
    }

    UBlueprint* NewLibrary = FKismetEditorUtilities::CreateBlueprint(
        UBlueprintFunctionLibrary::StaticClass(),
        Package,
        FName(*LibraryName),
        BPTYPE_FunctionLibrary,
        UBlueprint::StaticClass(),
        UBlueprintGeneratedClass::StaticClass(),
        NAME_None
    );

    if (NewLibrary)
    {
        NewLibrary->MarkPackageDirty();
        FKismetEditorUtilities::CompileBlueprint(NewLibrary);
        FAssetRegistryModule::AssetCreated(NewLibrary);
        
        UE_LOG(LogTemp, Log, TEXT("Created Blueprint Function Library: %s"), *LibraryName);
    }

    return NewLibrary;
}

UBlueprint* UBlueprintEditorUtilities::DuplicateBlueprint(UBlueprint* SourceBlueprint, const FString& NewPackagePath, const FString& NewName)
{
    if (!SourceBlueprint)
    {
        return nullptr;
    }

    FString PackageName = NewPackagePath + NewName;
    UPackage* Package = CreatePackage(*PackageName);
    
    if (!Package)
    {
        return nullptr;
    }

    UBlueprint* DuplicatedBlueprint = DuplicateObject<UBlueprint>(SourceBlueprint, Package, FName(*NewName));
    
    if (DuplicatedBlueprint)
    {
        DuplicatedBlueprint->MarkPackageDirty();
        FKismetEditorUtilities::CompileBlueprint(DuplicatedBlueprint);
        FAssetRegistryModule::AssetCreated(DuplicatedBlueprint);
        
        UE_LOG(LogTemp, Log, TEXT("Duplicated Blueprint: %s"), *NewName);
    }

    return DuplicatedBlueprint;
}

// ============================================================================
// ADDING COMPONENTS
// ============================================================================

bool UBlueprintEditorUtilities::AddComponentToBlueprint(UBlueprint* Blueprint, TSubclassOf<UActorComponent> ComponentClass, const FString& ComponentName)
{
    if (!Blueprint || !ComponentClass)
    {
        return false;
    }

    USimpleConstructionScript* SCS = Blueprint->SimpleConstructionScript;
    if (!SCS)
    {
        UE_LOG(LogTemp, Error, TEXT("Blueprint has no SimpleConstructionScript"));
        return false;
    }

    // Create new SCS node
    USCS_Node* NewNode = SCS->CreateNode(ComponentClass, FName(*ComponentName));
    
    if (!NewNode)
    {
        return false;
    }

    // Add to root nodes
    SCS->AddNode(NewNode);

    // Mark as modified and recompile
    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
    
    UE_LOG(LogTemp, Log, TEXT("Added component '%s' to Blueprint '%s'"), *ComponentName, *Blueprint->GetName());
    return true;
}

bool UBlueprintEditorUtilities::AddStaticMeshComponentToBlueprint(UBlueprint* Blueprint, const FString& ComponentName, UStaticMesh* Mesh)
{
    if (!Blueprint || !Mesh)
    {
        return false;
    }

    if (!AddComponentToBlueprint(Blueprint, UStaticMeshComponent::StaticClass(), ComponentName))
    {
        return false;
    }

    // Find the component we just created and set the mesh
    USimpleConstructionScript* SCS = Blueprint->SimpleConstructionScript;
    if (SCS)
    {
        for (USCS_Node* Node : SCS->GetAllNodes())
        {
            if (Node->GetVariableName() == FName(*ComponentName))
            {
                UStaticMeshComponent* SMC = Cast<UStaticMeshComponent>(Node->ComponentTemplate);
                if (SMC)
                {
                    SMC->SetStaticMesh(Mesh);
                    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
                    return true;
                }
            }
        }
    }

    return false;
}

bool UBlueprintEditorUtilities::AddSkeletalMeshComponentToBlueprint(UBlueprint* Blueprint, const FString& ComponentName, USkeletalMesh* SkeletalMesh)
{
    if (!Blueprint || !SkeletalMesh)
    {
        return false;
    }

    if (!AddComponentToBlueprint(Blueprint, USkeletalMeshComponent::StaticClass(), ComponentName))
    {
        return false;
    }

    USimpleConstructionScript* SCS = Blueprint->SimpleConstructionScript;
    if (SCS)
    {
        for (USCS_Node* Node : SCS->GetAllNodes())
        {
            if (Node->GetVariableName() == FName(*ComponentName))
            {
                USkeletalMeshComponent* SKC = Cast<USkeletalMeshComponent>(Node->ComponentTemplate);
                if (SKC)
                {
                    SKC->SetSkeletalMesh(SkeletalMesh);
                    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
                    return true;
                }
            }
        }
    }

    return false;
}

bool UBlueprintEditorUtilities::RemoveComponentFromBlueprint(UBlueprint* Blueprint, const FString& ComponentName)
{
    if (!Blueprint)
    {
        return false;
    }

    USimpleConstructionScript* SCS = Blueprint->SimpleConstructionScript;
    if (!SCS)
    {
        return false;
    }

    for (USCS_Node* Node : SCS->GetAllNodes())
    {
        if (Node->GetVariableName() == FName(*ComponentName))
        {
            SCS->RemoveNode(Node);
            FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
            
            UE_LOG(LogTemp, Log, TEXT("Removed component '%s' from Blueprint"), *ComponentName);
            return true;
        }
    }

    return false;
}

// ============================================================================
// ADDING VARIABLES
// ============================================================================

bool UBlueprintEditorUtilities::AddFloatVariable(UBlueprint* Blueprint, const FString& VariableName, float DefaultValue)
{
    if (!Blueprint)
    {
        return false;
    }

    FEdGraphPinType PinType;
    PinType.PinCategory = UEdGraphSchema_K2::PC_Real;
    PinType.PinSubCategory = UEdGraphSchema_K2::PC_Float;

    FName VarName = FBlueprintEditorUtils::FindUniqueKismetName(Blueprint, VariableName);
    FBlueprintEditorUtils::AddMemberVariable(Blueprint, VarName, PinType);

    // Set default value
    UClass* GeneratedClass = Blueprint->GeneratedClass;
    if (GeneratedClass)
    {
        FProperty* Property = GeneratedClass->FindPropertyByName(VarName);
        if (Property)
        {
            FFloatProperty* FloatProp = CastField<FFloatProperty>(Property);
            if (FloatProp)
            {
                UObject* CDO = GeneratedClass->GetDefaultObject();
                FloatProp->SetPropertyValue_InContainer(CDO, DefaultValue);
            }
        }
    }

    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
    
    UE_LOG(LogTemp, Log, TEXT("Added float variable '%s' to Blueprint"), *VariableName);
    return true;
}

