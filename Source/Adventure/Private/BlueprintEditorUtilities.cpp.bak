// ============================================================================
// COMPILATION AND SAVING
// ============================================================================

bool UBlueprintEditorUtilities::CompileBlueprint(UBlueprint* Blueprint)
{
    if (!Blueprint)
    {
        return false;
    }

    FKismetEditorUtilities::CompileBlueprint(Blueprint);
    
    UE_LOG(LogTemp, Log, TEXT("Compiled Blueprint: %s"), *Blueprint->GetName());
    return true;
}

bool UBlueprintEditorUtilities::SaveBlueprint(UBlueprint* Blueprint)
{
    if (!Blueprint)
    {
        return false;
    }

    UPackage* Package = Blueprint->GetOutermost();
    if (!Package)
    {
        return false;
    }

    FString PackageFileName = FPackageName::LongPackageNameToFilename(Package->GetName(), FPackageName::GetAssetPackageExtension());
    
    FSavePackageArgs SaveArgs;
    SaveArgs.TopLevelFlags = RF_Public | RF_Standalone;
    SaveArgs.SaveFlags = SAVE_NoError;
    
    bool bSaved = UPackage::SavePackage(Package, nullptr, *PackageFileName, SaveArgs);
    
    if (bSaved)
    {
        UE_LOG(LogTemp, Log, TEXT("Saved Blueprint: %s"), *Blueprint->GetName());
    }
    
    return bSaved;
}

void UBlueprintEditorUtilities::MarkBlueprintModified(UBlueprint* Blueprint)
{
    if (Blueprint)
    {
        FBlueprintEditorUtils::MarkBlueprintAsModified(Blueprint);
    }
}

// ============================================================================
// ASSET DISCOVERY
// ============================================================================

TArray<UBlueprint*> UBlueprintEditorUtilities::FindAllBlueprintsInPath(const FString& Path)
{
    TArray<UBlueprint*> Blueprints;
    
    FAssetRegistryModule& AssetRegistryModule = FModuleManager::LoadModuleChecked<FAssetRegistryModule>("AssetRegistry");
    
    TArray<FAssetData> AssetList;
    AssetRegistryModule.Get().GetAssetsByPath(FName(*Path), AssetList, true);
    
    for (const FAssetData& Asset : AssetList)
    {
        if (Asset.AssetClassPath.ToString() == TEXT("/Script/Engine.Blueprint"))
        {
            UBlueprint* Blueprint = Cast<UBlueprint>(Asset.GetAsset());
            if (Blueprint)
            {
                Blueprints.Add(Blueprint);
            }
        }
    }
    
    UE_LOG(LogTemp, Log, TEXT("Found %d Blueprint(s) in path: %s"), Blueprints.Num(), *Path);
    return Blueprints;
}

TArray<UBlueprint*> UBlueprintEditorUtilities::FindBlueprintsByParentClass(UClass* ParentClass)
{
    TArray<UBlueprint*> Blueprints;
    
    if (!ParentClass)
    {
        return Blueprints;
    }
    
    FAssetRegistryModule& AssetRegistryModule = FModuleManager::LoadModuleChecked<FAssetRegistryModule>("AssetRegistry");
    
    TArray<FAssetData> AssetList;
    AssetRegistryModule.Get().GetAssetsByClass(UBlueprint::StaticClass()->GetClassPathName(), AssetList, true);
    
    for (const FAssetData& Asset : AssetList)
    {
        UBlueprint* Blueprint = Cast<UBlueprint>(Asset.GetAsset());
        if (Blueprint && Blueprint->ParentClass && Blueprint->ParentClass->IsChildOf(ParentClass))
        {
            Blueprints.Add(Blueprint);
        }
    }
    
    return Blueprints;
}

UBlueprint* UBlueprintEditorUtilities::LoadBlueprintAsset(const FString& AssetPath)
{
    return LoadObject<UBlueprint>(nullptr, *AssetPath);
}

// ============================================================================
// BATCH OPERATIONS
// ============================================================================

int32 UBlueprintEditorUtilities::BatchAddVariableToBlueprints(const TArray<UBlueprint*>& Blueprints, 
    const FString& VariableName, const FString& VariableType)
{
    int32 SuccessCount = 0;
    
    for (UBlueprint* Blueprint : Blueprints)
    {
        if (!Blueprint)
        {
            continue;
        }
        
        bool bSuccess = false;
        
        if (VariableType == "Float")
        {
            bSuccess = AddFloatVariable(Blueprint, VariableName);
        }
        else if (VariableType == "Int")
        {
            bSuccess = AddIntVariable(Blueprint, VariableName);
        }
        else if (VariableType == "Bool")
        {
            bSuccess = AddBoolVariable(Blueprint, VariableName);
        }
        else if (VariableType == "String")
        {
            bSuccess = AddStringVariable(Blueprint, VariableName);
        }
        
        if (bSuccess)
        {
            SuccessCount++;
        }
    }
    
    UE_LOG(LogTemp, Log, TEXT("Batch added variable '%s' to %d/%d Blueprint(s)"), 
        *VariableName, SuccessCount, Blueprints.Num());
    
    return SuccessCount;
}

int32 UBlueprintEditorUtilities::BatchCompileBlueprints(const TArray<UBlueprint*>& Blueprints)
{
    int32 SuccessCount = 0;
    
    for (UBlueprint* Blueprint : Blueprints)
    {
        if (Blueprint)
        {
            FKismetEditorUtilities::CompileBlueprint(Blueprint);
            SuccessCount++;
        }
    }
    
    UE_LOG(LogTemp, Log, TEXT("Batch compiled %d Blueprint(s)"), SuccessCount);
    return SuccessCount;
}

bool UBlueprintEditorUtilities::ReparentBlueprint(UBlueprint* Blueprint, UClass* NewParentClass)
{
    if (!Blueprint || !NewParentClass)
    {
        return false;
    }

    Blueprint->ParentClass = NewParentClass;
    FBlueprintEditorUtils::RefreshAllNodes(Blueprint);
    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
    
    UE_LOG(LogTemp, Log, TEXT("Reparented Blueprint to: %s"), *NewParentClass->GetName());
    return true;
}

// ============================================================================
// INTERFACES
// ============================================================================

bool UBlueprintEditorUtilities::AddInterfaceToBlueprint(UBlueprint* Blueprint, TSubclassOf<UInterface> Interface)
{
    if (!Blueprint || !Interface)
    {
        return false;
    }

    Blueprint->ImplementedInterfaces.AddUnique(FBPInterfaceDescription(Interface));
    FBlueprintEditorUtils::RefreshAllNodes(Blueprint);
    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
    
    UE_LOG(LogTemp, Log, TEXT("Added interface to Blueprint"));
    return true;
}

bool UBlueprintEditorUtilities::RemoveInterfaceFromBlueprint(UBlueprint* Blueprint, TSubclassOf<UInterface> Interface)
{
    if (!Blueprint || !Interface)
    {
        return false;
    }

    for (int32 i = Blueprint->ImplementedInterfaces.Num() - 1; i >= 0; --i)
    {
        if (Blueprint->ImplementedInterfaces[i].Interface == Interface)
        {
            Blueprint->ImplementedInterfaces.RemoveAt(i);
            FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
            
            UE_LOG(LogTemp, Log, TEXT("Removed interface from Blueprint"));
            return true;
        }
    }

    return false;
}

#endif // WITH_EDITOR
