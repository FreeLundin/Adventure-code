bool UBlueprintEditorUtilities::AddObjectVariable(UBlueprint* Blueprint, const FString& VariableName, UClass* ObjectClass)
{
    if (!Blueprint || !ObjectClass)
    {
        return false;
    }

    FEdGraphPinType PinType;
    PinType.PinCategory = UEdGraphSchema_K2::PC_Object;
    PinType.PinSubCategoryObject = ObjectClass;

    FName VarName = FBlueprintEditorUtils::FindUniqueKismetName(Blueprint, VariableName);
    FBlueprintEditorUtils::AddMemberVariable(Blueprint, VarName, PinType);

    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
    
    UE_LOG(LogTemp, Log, TEXT("Added object variable '%s' to Blueprint"), *VariableName);
    return true;
}

bool UBlueprintEditorUtilities::AddArrayVariable(UBlueprint* Blueprint, const FString& VariableName, const FString& InnerType)
{
    if (!Blueprint)
    {
        return false;
    }

    FEdGraphPinType PinType;
    PinType.ContainerType = EPinContainerType::Array;
    
    // Set inner type based on string
    if (InnerType == "Float")
    {
        PinType.PinCategory = UEdGraphSchema_K2::PC_Real;
        PinType.PinSubCategory = UEdGraphSchema_K2::PC_Float;
    }
    else if (InnerType == "Int")
    {
        PinType.PinCategory = UEdGraphSchema_K2::PC_Int;
    }
    else if (InnerType == "String")
    {
        PinType.PinCategory = UEdGraphSchema_K2::PC_String;
    }
    else
    {
        PinType.PinCategory = UEdGraphSchema_K2::PC_String; // Default
    }

    FName VarName = FBlueprintEditorUtils::FindUniqueKismetName(Blueprint, VariableName);
    FBlueprintEditorUtils::AddMemberVariable(Blueprint, VarName, PinType);

    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
    
    UE_LOG(LogTemp, Log, TEXT("Added array variable '%s' to Blueprint"), *VariableName);
    return true;
}

FBPVariableDescription* UBlueprintEditorUtilities::FindVariable(UBlueprint* Blueprint, const FName& VariableName)
{
    if (!Blueprint)
    {
        return nullptr;
    }

    for (FBPVariableDescription& Variable : Blueprint->NewVariables)
    {
        if (Variable.VarName == VariableName)
        {
            return &Variable;
        }
    }

    return nullptr;
}

bool UBlueprintEditorUtilities::SetVariableMetadata(UBlueprint* Blueprint, const FString& VariableName, 
    bool bEditAnywhere, bool bBlueprintReadOnly, const FString& Category)
{
    if (!Blueprint)
    {
        return false;
    }

    FBPVariableDescription* Variable = FindVariable(Blueprint, FName(*VariableName));
    if (!Variable)
    {
        return false;
    }

    // Set property flags
    if (bEditAnywhere)
    {
        Variable->PropertyFlags |= CPF_Edit;
    }

    if (bBlueprintReadOnly)
    {
        Variable->PropertyFlags |= CPF_BlueprintReadOnly;
    }
    else
    {
        Variable->PropertyFlags &= ~CPF_BlueprintReadOnly;
    }

    // Set category
    if (!Category.IsEmpty())
    {
        Variable->Category = FText::FromString(Category);
    }

    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
    return true;
}

bool UBlueprintEditorUtilities::RemoveVariable(UBlueprint* Blueprint, const FString& VariableName)
{
    if (!Blueprint)
    {
        return false;
    }

    FName VarName(*VariableName);
    FBlueprintEditorUtils::RemoveMemberVariable(Blueprint, VarName);
    
    UE_LOG(LogTemp, Log, TEXT("Removed variable '%s' from Blueprint"), *VariableName);
    return true;
}

// ============================================================================
// FUNCTIONS
// ============================================================================

bool UBlueprintEditorUtilities::AddFunction(UBlueprint* Blueprint, const FString& FunctionName)
{
    if (!Blueprint)
    {
        return false;
    }

    UEdGraph* NewGraph = FBlueprintEditorUtils::CreateNewGraph(
        Blueprint,
        FName(*FunctionName),
        UEdGraph::StaticClass(),
        UEdGraphSchema_K2::StaticClass()
    );

    if (NewGraph)
    {
        FBlueprintEditorUtils::AddFunctionGraph(Blueprint, NewGraph, true, nullptr);
        FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
        
        UE_LOG(LogTemp, Log, TEXT("Added function '%s' to Blueprint"), *FunctionName);
        return true;
    }

    return false;
}

bool UBlueprintEditorUtilities::AddFunctionOverride(UBlueprint* Blueprint, const FString& FunctionName)
{
    if (!Blueprint)
    {
        return false;
    }

    UClass* ParentClass = Blueprint->ParentClass;
    if (!ParentClass)
    {
        return false;
    }

    UFunction* ParentFunction = ParentClass->FindFunctionByName(FName(*FunctionName));
    if (!ParentFunction)
    {
        UE_LOG(LogTemp, Warning, TEXT("Function '%s' not found in parent class"), *FunctionName);
        return false;
    }

    UEdGraph* NewGraph = FBlueprintEditorUtils::CreateNewGraph(
        Blueprint,
        ParentFunction->GetFName(),
        UEdGraph::StaticClass(),
        UEdGraphSchema_K2::StaticClass()
    );

    if (NewGraph)
    {
        FBlueprintEditorUtils::AddFunctionGraph(Blueprint, NewGraph, false, ParentFunction);
        FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
        
        UE_LOG(LogTemp, Log, TEXT("Added function override '%s' to Blueprint"), *FunctionName);
        return true;
    }

    return false;
}

bool UBlueprintEditorUtilities::AddCustomEvent(UBlueprint* Blueprint, const FString& EventName)
{
    if (!Blueprint)
    {
        return false;
    }

    // Custom events are stored in the event graph
    TArray<UEdGraph*> EventGraphs;
    FBlueprintEditorUtils::GetAllGraphsOfClass(Blueprint, UEdGraph::StaticClass(), EventGraphs);

    if (EventGraphs.Num() > 0)
    {
        UEdGraph* EventGraph = EventGraphs[0];
        FName UniqueName = FBlueprintEditorUtils::FindUniqueKismetName(Blueprint, EventName);
        
        UK2Node_CustomEvent* CustomEventNode = FBlueprintEditorUtils::AddCustomEventToGraph(
            EventGraph,
            UniqueName,
            nullptr
        );

        if (CustomEventNode)
        {
            FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
            UE_LOG(LogTemp, Log, TEXT("Added custom event '%s' to Blueprint"), *EventName);
            return true;
        }
    }

    return false;
}

// ============================================================================
// MODIFYING PROPERTIES
// ============================================================================

UObject* UBlueprintEditorUtilities::GetBlueprintCDO(UBlueprint* Blueprint)
{
    if (!Blueprint || !Blueprint->GeneratedClass)
    {
        return nullptr;
    }

    return Blueprint->GeneratedClass->GetDefaultObject();
}

bool UBlueprintEditorUtilities::SetBlueprintDefaultFloatProperty(UBlueprint* Blueprint, const FString& PropertyName, float Value)
{
    UObject* CDO = GetBlueprintCDO(Blueprint);
    if (!CDO)
    {
        return false;
    }

    FProperty* Property = CDO->GetClass()->FindPropertyByName(FName(*PropertyName));
    if (!Property)
    {
        return false;
    }

    FFloatProperty* FloatProp = CastField<FFloatProperty>(Property);
    if (!FloatProp)
    {
        return false;
    }

    FloatProp->SetPropertyValue_InContainer(CDO, Value);
    FBlueprintEditorUtils::MarkBlueprintAsModified(Blueprint);
    
    return true;
}

