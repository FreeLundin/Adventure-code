// BlueprintRuntimeManager.cpp

#include "BlueprintRuntimeManager.h"
#include "Kismet/GameplayStatics.h"
#include "Engine/World.h"
#include "Engine/StreamableManager.h"
#include "Engine/AssetManager.h"
#include "UObject/ConstructorHelpers.h"

ABlueprintRuntimeManager::ABlueprintRuntimeManager()
{
    PrimaryActorTick.bCanEverTick = false;
}

void ABlueprintRuntimeManager::BeginPlay()
{
    Super::BeginPlay();
}

// ============================================================================
// SPAWNING BLUEPRINT ACTORS
// ============================================================================

AActor* ABlueprintRuntimeManager::SpawnBlueprintActor(FVector Location, FRotator Rotation)
{
    if (!BlueprintActorClass)
    {
        UE_LOG(LogTemp, Warning, TEXT("BlueprintActorClass is not set!"));
        return nullptr;
    }

    FActorSpawnParameters SpawnParams;
    SpawnParams.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AlwaysSpawn;

    AActor* SpawnedActor = GetWorld()->SpawnActor<AActor>(BlueprintActorClass, Location, Rotation, SpawnParams);
    
    if (SpawnedActor)
    {
        UE_LOG(LogTemp, Log, TEXT("Successfully spawned Blueprint actor: %s"), *SpawnedActor->GetName());
    }

    return SpawnedActor;
}

AActor* ABlueprintRuntimeManager::SpawnBlueprintActorFromPath(const FString& BlueprintPath, FVector Location, FRotator Rotation)
{
    UClass* LoadedClass = LoadBlueprintClass(BlueprintPath);
    
    if (!LoadedClass)
    {
        UE_LOG(LogTemp, Warning, TEXT("Failed to load Blueprint class from path: %s"), *BlueprintPath);
        return nullptr;
    }

    FActorSpawnParameters SpawnParams;
    SpawnParams.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AlwaysSpawn;

    return GetWorld()->SpawnActor<AActor>(LoadedClass, Location, Rotation, SpawnParams);
}

// ============================================================================
// PROPERTY ACCESS
// ============================================================================

FProperty* ABlueprintRuntimeManager::FindPropertyByName(UObject* Object, FName PropertyName)
{
    if (!Object)
    {
        return nullptr;
    }

    UClass* Class = Object->GetClass();
    return Class->FindPropertyByName(PropertyName);
}

bool ABlueprintRuntimeManager::GetBlueprintPropertyFloat(AActor* TargetActor, FName PropertyName, float& OutValue)
{
    FProperty* Property = FindPropertyByName(TargetActor, PropertyName);
    
    if (!Property)
    {
        UE_LOG(LogTemp, Warning, TEXT("Property '%s' not found on actor '%s'"), 
            *PropertyName.ToString(), *TargetActor->GetName());
        return false;
    }

    FFloatProperty* FloatProperty = CastField<FFloatProperty>(Property);
    if (!FloatProperty)
    {
        UE_LOG(LogTemp, Warning, TEXT("Property '%s' is not a float"), *PropertyName.ToString());
        return false;
    }

    OutValue = FloatProperty->GetPropertyValue_InContainer(TargetActor);
    return true;
}

bool ABlueprintRuntimeManager::GetBlueprintPropertyInt(AActor* TargetActor, FName PropertyName, int32& OutValue)
{
    FProperty* Property = FindPropertyByName(TargetActor, PropertyName);
    
    if (!Property)
    {
        return false;
    }

    FIntProperty* IntProperty = CastField<FIntProperty>(Property);
    if (!IntProperty)
    {
        return false;
    }

    OutValue = IntProperty->GetPropertyValue_InContainer(TargetActor);
    return true;
}

bool ABlueprintRuntimeManager::GetBlueprintPropertyBool(AActor* TargetActor, FName PropertyName, bool& OutValue)
{
    FProperty* Property = FindPropertyByName(TargetActor, PropertyName);
    
    if (!Property)
    {
        return false;
    }

    FBoolProperty* BoolProperty = CastField<FBoolProperty>(Property);
    if (!BoolProperty)
    {
        return false;
    }

    OutValue = BoolProperty->GetPropertyValue_InContainer(TargetActor);
    return true;
}

bool ABlueprintRuntimeManager::GetBlueprintPropertyString(AActor* TargetActor, FName PropertyName, FString& OutValue)
{
    FProperty* Property = FindPropertyByName(TargetActor, PropertyName);
    
    if (!Property)
    {
        return false;
    }

    FStrProperty* StrProperty = CastField<FStrProperty>(Property);
    if (!StrProperty)
    {
        return false;
    }

    OutValue = StrProperty->GetPropertyValue_InContainer(TargetActor);
    return true;
}

bool ABlueprintRuntimeManager::SetBlueprintPropertyFloat(AActor* TargetActor, FName PropertyName, float Value)
{
    FProperty* Property = FindPropertyByName(TargetActor, PropertyName);
    
    if (!Property)
    {
        UE_LOG(LogTemp, Warning, TEXT("Property '%s' not found"), *PropertyName.ToString());
        return false;
    }

    FFloatProperty* FloatProperty = CastField<FFloatProperty>(Property);
    if (!FloatProperty)
    {
        UE_LOG(LogTemp, Warning, TEXT("Property '%s' is not a float"), *PropertyName.ToString());
        return false;
    }

    FloatProperty->SetPropertyValue_InContainer(TargetActor, Value);
    UE_LOG(LogTemp, Log, TEXT("Set property '%s' to %f on actor '%s'"), 
        *PropertyName.ToString(), Value, *TargetActor->GetName());
    return true;
}

bool ABlueprintRuntimeManager::SetBlueprintPropertyInt(AActor* TargetActor, FName PropertyName, int32 Value)
{
    FProperty* Property = FindPropertyByName(TargetActor, PropertyName);
    
    if (!Property)
    {
